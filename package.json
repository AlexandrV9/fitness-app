{
  "name": "fitness-app",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev -w @fitness-app/web-client",
    "dev:server": "npm run dev -w @fitness-app/server",
    "build": "npm run build -w @fitness-app/web-client && npm run build -w @fitness-app/server",
    "build:web": "npm run build -w @fitness-app/web-client",
    "build:server": "npm run build -w @fitness-app/server",
    "start:server": "npm run start -w @fitness-app/server",
    "verify": "npm run lint && npm run lint:server && npm run test",
    "db:up": "docker compose --env-file packages/server/.env -f .docker/docker-compose.yaml up -d postgres",
    "db:down": "docker compose --env-file packages/server/.env -f .docker/docker-compose.yaml stop",
    "db:rm": "docker compose --env-file packages/server/.env -f .docker/docker-compose.yaml down",
    "db:ps": "docker compose --env-file packages/server/.env -f .docker/docker-compose.yaml ps",
    "db:setup": "npm run db:setup -w @fitness-app/server",
    "docker:up": "docker compose --env-file .env up -d --build",
    "docker:down": "docker compose --env-file .env down",
    "docker:prod": "docker compose -f docker-compose.prod.yml --env-file .env up -d",
    "lint": "npm run lint -w @fitness-app/web-client",
    "preview": "npm run preview -w @fitness-app/web-client",
    "test": "npm run test -w @fitness-app/server",
    "test:server": "npm run test -w @fitness-app/server",
    "lint:server": "npm run lint -w @fitness-app/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
