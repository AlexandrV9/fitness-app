# Database
DB_NAME=fitness-app
DB_USER=postgres
DB_PASSWORD=change_me
DB_PORT=5432

# Server
SERVER_PORT=8000
CLIENT_PORT=3000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
# RESET_PASSWORD_TOKEN_SECRET=

# Client build (docker-compose.yml / GitHub Actions Variables)
# Same-origin: browser hits one URL; nginx proxies /api → server
VITE_API_ENDPOINT=http://localhost:3000

# Production (docker-compose.prod.yml)
# GHCR_IMAGE_PREFIX=ghcr.io/alexandrv9/fitness-app
# IMAGE_TAG=latest
# CLIENT_PORT=8081
# ALLOWED_ORIGINS=https://app.example.com
# CLIENT_URL=https://app.example.com
# VITE_API_ENDPOINT=https://app.example.com   # GitHub Actions Variable (optional for build)

# pgadmin (optional: docker compose --profile tools up)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
