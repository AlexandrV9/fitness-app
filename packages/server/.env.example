# Локальная разработка на хосте (npm run dev:server).
# Для полного Docker-стека / prod используйте корневой .env (.env.example).

SERVER_PORT=8000
CLIENT_PORT=3000
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
NODE_ENV=development

# PostgreSQL in Docker (.docker/docker-compose.yaml)
# Host app → localhost; server container uses host `postgres`
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=fitness-app
DB_USER=postgres
DB_PASSWORD=change_me

ACCESS_TOKEN_SECRET=change_me_access
REFRESH_TOKEN_SECRET=change_me_refresh
# RESET_PASSWORD_TOKEN_SECRET=

# Optional: docker compose --profile tools (pgAdmin on :8080)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
