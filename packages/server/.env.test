# Vitest overrides (loaded last in packages/server/tests/setup/vitest.setup.ts).
# Tests run in ephemeral Docker Postgres — dev DB is never touched.

USE_TESTCONTAINERS=true
DEV_DB_PROTECT=fitness-app
TEST_DB_NAME=fitness_app_test

# Secrets for server config imports in tests
ACCESS_TOKEN_SECRET=test_access_secret_change_me
REFRESH_TOKEN_SECRET=test_refresh_secret_change_me
ALLOWED_ORIGINS=http://localhost:3000
