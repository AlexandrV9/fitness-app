{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "promise", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "vitest/expect-expect": [
      "error",
      {
        "assertFunctionNames": [
          "expect",
          "expectTypeOf",
          "assert",
          "assertType",
          "expectStatus",
          "expectErrorMessage",
          "expectErrorCode",
          "expectUnauthorized"
        ]
      }
    ]
  },
  "ignorePatterns": ["dist/**", "coverage/**", "**/*.d.ts"]
}
